---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';

const services = [
	{
		name: 'Box Braids',
		price: '$180',
		description: 'Classic, versatile box braids with a neat, long-lasting finish.',
	},
	{
		name: 'Knotless Braids',
		price: '$200',
		description: 'Gentle, natural-looking braids that start pain-free at the root.',
	},
	{
		name: 'Cornrows',
		price: '$70',
		description: 'Clean, precise cornrows in straight-back or custom patterns.',
	},
	{
		name: 'Twists',
		price: '$200',
		description: 'Soft, protective twists with fullness and beautiful texture.',
	},
];
---

<!doctype html>
<html lang="en">
	<BaseHead
		title="Joe Braiding | Hair Braiding in Duluth, GA"
		description={SITE_DESCRIPTION}
	/>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-inner">
					<p class="hero-kicker">Professional hair braiding &middot; Duluth, GA</p>
					<h1>Beautiful Braids, Done Right</h1>
					<p class="hero-sub">
						Expert hair braiding in Duluth, GA. Neat parts, gentle hands, and styles
						that turn heads &mdash; box braids, knotless braids, cornrows, and twists.
					</p>
					<div class="hero-actions">
						<a href="tel:+16055854899" class="btn btn-primary">Call or Text to Book</a>
						<a href="#services" class="btn btn-secondary">View Services</a>
					</div>
					<p class="hero-phone">
						<a href="tel:+16055854899">(605) 585-4899</a>
					</p>
				</div>
			</section>

			<section id="services" class="services">
				<div class="section-inner">
					<h2>Services &amp; Prices</h2>
					<p class="section-sub">
						Quality braiding at honest prices. Call or text to confirm pricing for
						extra length or specialty styles.
					</p>
					<ul class="service-grid">
						{services.map((service) => (
							<li class="service-card">
								<div class="service-top">
									<h3>{service.name}</h3>
									<span class="service-price">{service.price}</span>
								</div>
								<p>{service.description}</p>
								<a href="tel:+16055854899" class="service-book">
									Book this style &rarr;
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section id="visit" class="visit">
				<div class="section-inner visit-inner">
					<h2>Visit Us</h2>
					<p>
						Located in <strong>Duluth, GA</strong> and serving the greater Gwinnett
						County area. Appointments are recommended &mdash; walk-ins are welcome
						when availability allows.
					</p>
				</div>
			</section>

			<section id="contact" class="contact">
				<div class="section-inner contact-inner">
					<h2>Ready for Your New Look?</h2>
					<p class="section-sub">
						Call or text to book your appointment. Same-week slots often available!
					</p>
					<a href="tel:+16055854899" class="btn btn-primary btn-large">
						Call or Text (605) 585-4899
					</a>
				</div>
			</section>
		</main>
		<Footer />
		<style>
			.hero {
				background: linear-gradient(135deg, rgb(58, 36, 18) 0%, rgb(122, 74, 30) 100%);
				color: white;
			padding: 6em 1em;
			text-align: center;
		}
			.hero-inner {
				max-width: 720px;
			margin: auto;
		}
			.hero-kicker {
			margin: 0 0 1em;
		text-transform: uppercase;
			letter-spacing: 0.15em;
			font-size: 0.85em;
			color: rgb(246, 214, 165);
		}
			.hero h1 {
			font-size: 3em;
			margin: 0 0 0.4em;
			line-height: 1.1;
		}
			.hero-sub {
			font-size: 1.15em;
			line-height: 1.7;
			color: rgb(246, 232, 216);
			margin-bottom: 2em;
		}
			.hero-actions {
			display: flex;
			gap: 1em;
			justify-content: center;
			flex-wrap: wrap;
		}
			.hero-phone {
			margin: 1.5em 0 0;
		font-size: 1.1em;
		}
			.hero-phone a {
			color: white;
			font-weight: 600;
		}
			.btn {
			display: inline-block;
			padding: 0.9em 2em;
			border-radius: 999px;
			text-decoration: none;
			font-weight: 700;
			font-size: 1em;
			transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
		}
			.btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
		}
			.btn-primary {
			background: rgb(216, 142, 43);
			color: rgb(58, 36, 18);
		}
			.btn-primary:hover {
			background: rgb(232, 160, 60);
			color: rgb(58, 36, 18);
		}
			.btn-secondary {
			background: transparent;
			color: white;
			border: 2px solid rgb(246, 214, 165);
		}
			.btn-secondary:hover {
			background: rgba(255, 255, 255, 0.12);
			color: white;
		}
			.btn-large {
			font-size: 1.15em;
			padding: 1em 2.5em;
		}
			.services {
			padding: 5em 1em;
			background: white;
		}
			.section-inner {
			max-width: 1020px;
			margin: auto;
		}
			.services h2,
			.visit h2,
			.contact h2 {
			text-align: center;
			font-size: 2em;
			margin: 0 0 0.25em;
		}
			.section-sub {
			text-align: center;
			color: rgb(var(--gray-dark));
			margin-bottom: 2.5em;
		}
			.service-grid {
			list-style: none;
		margin: 0;
			padding: 0;
		display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1.5em;
		}
			.service-card {
			background: rgb(255, 251, 245);
			border: 1px solid rgb(240, 225, 205);
			border-radius: 12px;
			padding: 1.75em;
		display: flex;
			flex-direction: column;
			box-shadow: 0 2px 10px rgba(122, 74, 30, 0.08);
		}
			.service-top {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.75em;
			margin-bottom: 0.5em;
		}
			.service-card h3 {
			margin: 0;
			font-size: 1.25em;
		}
			.service-price {
			font-size: 1.5em;
			font-weight: 800;
			color: rgb(122, 74, 30);
			white-space: nowrap;
		}
			.service-card p {
			color: rgb(var(--gray-dark));
			flex: 1;
		}
			.service-book {
			margin-top: 1em;
			font-weight: 600;
			color: rgb(122, 74, 30);
		}
			.visit {
			padding: 4em 1em;
			background: rgb(255, 251, 245);
		}
			.visit-inner {
			max-width: 720px;
			text-align: center;
		}
			.contact {
			padding: 5em 1em;
			background: linear-gradient(var(--gray-gradient)) no-repeat;
		}
			.contact-inner {
			max-width: 720px;
			text-align: center;
		}
			@media (max-width: 720px) {
				.hero {
					padding: 4em 1em;
			}
				.hero h1 {
					font-size: 2.2em;
			}
				.services,
				.contact {
					padding: 3.5em 1em;
				}
			}
		</style>
	</body>
</html>
