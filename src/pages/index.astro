---
const PHONE_DISPLAY = "(605) 585-4899";
const PHONE_LINK = "tel:+16055854899";

const services = [
  {
    name: "Box Braids",
    price: 180,
    desc: "The timeless classic. Neat, versatile, protective — a style that works for every occasion and lasts for weeks.",
    tag: "Most loved",
  },
  {
    name: "Knotless Braids",
    price: 200,
    desc: "Lightweight and natural-looking with a seamless, pain-free start. All the beauty, none of the tension.",
    tag: "Gentle on edges",
  },
  {
    name: "Cornrows",
    price: 70,
    desc: "Sleek, clean rows braided close to the scalp — from simple straight-backs to creative patterns.",
    tag: "Quick & sleek",
  },
  {
    name: "Twists",
    price: 200,
    desc: "Soft, full twists with beautiful texture and movement. Effortless elegance that turns heads.",
    tag: "Soft texture",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Joy Braiding | Hair Braiding in Duluth, GA</title>
    <meta
      name="description"
      content="Joy Braiding — professional hair braiding in Duluth, GA. Box braids, knotless braids, cornrows and twists. Call or text (605) 585-4899 to book."
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href="https://joybraiding.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joy Braiding" />
    <meta property="og:title" content="Joy Braiding | Hair Braiding in Duluth, GA" />
    <meta
      property="og:description"
      content="Professional hair braiding in Duluth, GA. Box braids, knotless braids, cornrows and twists. Call or text (605) 585-4899 to book."
    />
    <meta property="og:url" content="https://joybraiding.com/" />
    <meta property="og:image" content="https://joybraiding.com/joe.jpg" />
    <meta property="og:image:alt" content="Joy, professional hair braider in Duluth, Georgia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Joy Braiding | Hair Braiding in Duluth, GA" />
    <meta
      name="twitter:description"
      content="Professional hair braiding in Duluth, GA. Box braids, knotless braids, cornrows and twists. Call or text (605) 585-4899 to book."
    />
    <meta name="twitter:image" content="https://joybraiding.com/joe.jpg" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Joy Braiding",
        "description": "Professional hair braiding in Duluth, Georgia. Box braids, knotless braids, cornrows and twists.",
        "url": "https://joybraiding.com/",
        "image": "https://joybraiding.com/joe.jpg",
        "telephone": "+1-605-585-4899",
        "priceRange": "$70 - $200",
        "sameAs": ["https://www.facebook.com/braidingjoy"],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Duluth",
          "addressRegion": "GA",
          "addressCountry": "US"
        },
        "areaServed": ["Duluth, GA", "Gwinnett County, GA", "Atlanta metro"],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "08:00",
            "closes": "19:00"
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Braiding services",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Box Braids" }, "price": "180", "priceCurrency": "USD" },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Knotless Braids" }, "price": "200", "priceCurrency": "USD" },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cornrows" }, "price": "70", "priceCurrency": "USD" },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Twists" }, "price": "200", "priceCurrency": "USD" }
          ]
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does hair braiding cost?",
            "acceptedAnswer": { "@type": "Answer", "text": "Box Braids — $180. Knotless Braids — $200. Cornrows — $70. Twists — $200. Final pricing is confirmed when you book." }
          },
          {
            "@type": "Question",
            "name": "How do I book an appointment?",
            "acceptedAnswer": { "@type": "Answer", "text": "Call or text (605) 585-4899 to book. Visits are by appointment." }
          },
          {
            "@type": "Question",
            "name": "What are your hours?",
            "acceptedAnswer": { "@type": "Answer", "text": "Monday through Saturday, 8:00 AM to 7:00 PM. Closed on Sundays." }
          },
          {
            "@type": "Question",
            "name": "Where are you located?",
            "acceptedAnswer": { "@type": "Answer", "text": "Joy Braiding is based in Duluth, Georgia, serving Gwinnett County and the Atlanta metro. The exact address is shared when you book your appointment." }
          },
          {
            "@type": "Question",
            "name": "Do you take walk-ins?",
            "acceptedAnswer": { "@type": "Answer", "text": "Visits are by appointment so every client gets full attention. Call or text ahead to reserve your spot." }
          },
          {
            "@type": "Question",
            "name": "What should I bring to my appointment?",
            "acceptedAnswer": { "@type": "Answer", "text": "Just bring yourself — when you book, Joy will let you know if anything is needed for your chosen style." }
          }
        ]
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --cream: #faf6ef;
        --cream-deep: #f3ecdf;
        --espresso: #241a12;
        --espresso-soft: #3a2c1f;
        --gold: #c2913b;
        --gold-deep: #a5762a;
        --clay: #8a5a33;
        --muted: #6f5f4e;
        --card: #ffffff;
        --radius: 20px;
        --shadow: 0 20px 45px -20px rgba(36, 26, 18, 0.25);
        --font-display: "Fraunces", Georgia, serif;
        --font-body: "Manrope", system-ui, -apple-system, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--cream);
        color: var(--espresso);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: var(--gold); color: #fff; }
      img { max-width: 100%; }
      a { color: inherit; }

      .wrap { width: min(1120px, 92%); margin: 0 auto; }

      /* ---------- Nav ---------- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(250, 246, 239, 0.85);
        border-bottom: 1px solid rgba(36, 26, 18, 0.08);
      }
      .nav-inner {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.9rem 0;
      }
      .brand {
        display: flex; align-items: center; gap: 0.65rem;
        text-decoration: none; font-weight: 800; letter-spacing: 0.02em;
      }
      .brand-logo {
        width: 40px; height: 40px; border-radius: 50%;
        object-fit: cover; border: 2px solid rgba(194, 145, 59, 0.55);
        box-shadow: 0 4px 12px -4px rgba(36, 26, 18, 0.35);
      }
      .brand-name { font-size: 1.15rem; }
      .brand-name span { color: var(--gold-deep); }
      .nav-links { display: flex; gap: 1.75rem; align-items: center; }
      .nav-links a.link {
        text-decoration: none; font-weight: 600; font-size: 0.95rem; color: var(--espresso-soft);
      }
      .nav-links a.link:hover { color: var(--gold-deep); }
      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        text-decoration: none; font-weight: 700;
        border-radius: 999px; padding: 0.7rem 1.4rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
      }
      .btn-gold { background: var(--gold); color: #fff; box-shadow: 0 10px 24px -10px rgba(194, 145, 59, 0.7); }
      .btn-gold:hover { background: var(--gold-deep); transform: translateY(-2px); }
      .btn-outline {
        border: 2px solid rgba(36, 26, 18, 0.2); color: var(--espresso);
        background: transparent;
      }
      .btn-outline:hover { border-color: var(--gold); color: var(--gold-deep); }
      .btn-dark { background: var(--espresso); color: var(--cream); }
      .btn-dark:hover { background: var(--espresso-soft); transform: translateY(-2px); }

      /* ---------- Hero ---------- */
      .hero {
        position: relative; overflow: hidden;
        padding: 5.5rem 0 4.5rem;
        background:
          radial-gradient(900px 480px at 85% -10%, rgba(194, 145, 59, 0.22), transparent 60%),
          radial-gradient(700px 420px at 5% 110%, rgba(138, 90, 51, 0.16), transparent 60%),
          var(--cream);
      }
      .hero::after {
        content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.5;
        background-image: radial-gradient(rgba(36,26,18,0.10) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: radial-gradient(600px 400px at 80% 20%, black, transparent 70%);
      }
      .pill {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: #fff; border: 1px solid rgba(36,26,18,0.1);
        padding: 0.45rem 1rem; border-radius: 999px;
        font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--clay); box-shadow: var(--shadow);
      }
      .pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); }
      .hero h1 {
        font-family: var(--font-display);
        font-size: clamp(2.8rem, 6.5vw, 4.8rem);
        line-height: 1.04; letter-spacing: -0.01em;
        margin: 1.4rem 0 1.1rem; max-width: 14ch;
      }
      .hero h1 em { font-style: italic; color: var(--gold-deep); }
      .hero p.lead {
        font-size: 1.15rem; color: var(--muted); max-width: 52ch; margin: 0 0 2rem;
      }
      .hero-ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; }
      .hero-meta {
        display: flex; gap: 2.2rem; flex-wrap: wrap; margin-top: 2.6rem;
        color: var(--muted); font-size: 0.95rem; font-weight: 600;
      }
      .hero-meta strong { display: block; color: var(--espresso); font-size: 1.05rem; }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 3.5rem; align-items: center; position: relative; z-index: 1; }
      .hero-photo { position: relative; width: min(400px, 100%); justify-self: end; }
      .hero-photo::before {
        content: ""; position: absolute; inset: 30px -26px -26px 26px;
        background: linear-gradient(135deg, var(--gold), var(--clay));
        border-radius: 200px 200px 26px 26px; opacity: 0.35;
      }
      .hero-photo img {
        position: relative; width: 100%; height: 520px; object-fit: cover; object-position: top center;
        border-radius: 200px 200px 24px 24px; border: 6px solid #fff;
        box-shadow: var(--shadow); display: block;
      }
      .hero-badge {
        position: absolute; left: -34px; bottom: 44px;
        background: #fff; border: 1px solid rgba(36,26,18,0.08);
        border-radius: 999px; padding: 0.6rem 1.2rem;
        font-weight: 800; font-size: 0.9rem; box-shadow: var(--shadow); white-space: nowrap;
      }

      /* ---------- Sections ---------- */
      section.block { padding: 4.5rem 0; }
      .kicker {
        text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem;
        font-weight: 800; color: var(--gold-deep); margin: 0 0 0.6rem;
      }
      h2.title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 1.1; margin: 0 0 1rem; letter-spacing: -0.01em;
      }
      .sub { color: var(--muted); max-width: 60ch; margin: 0 0 2.5rem; font-size: 1.05rem; }

      /* ---------- Services ---------- */
      .services { background: var(--cream-deep); border-top: 1px solid rgba(36,26,18,0.07); border-bottom: 1px solid rgba(36,26,18,0.07); }
      .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
      .card {
        background: var(--card); border-radius: var(--radius);
        padding: 2rem; box-shadow: var(--shadow);
        border: 1px solid rgba(36,26,18,0.06);
        display: flex; flex-direction: column; gap: 0.7rem;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        position: relative; overflow: hidden;
      }
      .card::before {
        content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px;
        background: linear-gradient(90deg, var(--gold), var(--clay));
        opacity: 0; transition: opacity 0.18s ease;
      }
      .card:hover { transform: translateY(-6px); }
      .card:hover::before { opacity: 1; }
      .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
      .card h3 { font-family: var(--font-display); font-size: 1.5rem; margin: 0; }
      .price {
        font-weight: 800; font-size: 1.35rem; color: var(--gold-deep);
        background: rgba(194,145,59,0.12); padding: 0.25rem 0.9rem; border-radius: 999px;
        white-space: nowrap;
      }
      .card p { margin: 0; color: var(--muted); flex: 1; }
      .tag {
        align-self: flex-start; font-size: 0.75rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--clay); background: rgba(138,90,51,0.1);
        padding: 0.3rem 0.8rem; border-radius: 999px;
      }
      .card a.book {
        margin-top: 0.6rem; font-weight: 800; color: var(--espresso);
        text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;
      }
      .card a.book:hover { color: var(--gold-deep); }
      .card a.book::after { content: "→"; transition: transform 0.15s ease; }
      .card a.book:hover::after { transform: translateX(4px); }

      /* ---------- Work gallery ---------- */
      .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
      .work-item {
        margin: 0; border-radius: var(--radius); overflow: hidden;
        background: var(--card); border: 1px solid rgba(36, 26, 18, 0.06);
        box-shadow: var(--shadow);
      }
      .work-item img {
        width: 100%; aspect-ratio: 3 / 4; object-fit: cover; display: block;
        transition: transform 0.3s ease;
      }
      .work-item:hover img { transform: scale(1.05); }
      .work-item figcaption {
        padding: 0.85rem 1.15rem; font-weight: 700; font-size: 0.95rem;
      }

      /* ---------- Visit (dark) ---------- */
      .visit { background: var(--espresso); color: var(--cream); border-radius: 28px; }
      .visit .kicker { color: var(--gold); }
      .visit h2.title { color: #fff; }
      .visit .sub { color: rgba(250,246,239,0.72); }
      .visit-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 0.5rem; }
      .visit-card {
        background: rgba(250,246,239,0.06);
        border: 1px solid rgba(250,246,239,0.12);
        border-radius: 16px; padding: 1.6rem;
      }
      .visit-card h4 { margin: 0 0 0.4rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold); }
      .visit-card p { margin: 0; font-size: 1.05rem; font-weight: 600; }
      .visit-card a { color: #fff; text-decoration: none; font-weight: 800; font-size: 1.25rem; }
      .visit-card a:hover { color: var(--gold); }

      /* ---------- CTA ---------- */
      .cta-band {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-deep) 100%);
        border-radius: 28px; padding: 3.5rem 2.5rem; text-align: center; color: #fff;
        box-shadow: var(--shadow); position: relative; overflow: hidden;
      }
      .cta-band::before {
        content: ""; position: absolute; inset: 0; opacity: 0.18;
        background-image: radial-gradient(rgba(255,255,255,0.9) 1px, transparent 1px);
        background-size: 22px 22px;
      }
      .cta-band > * { position: relative; }
      .cta-band h2 {
        font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3rem);
        margin: 0 0 0.6rem; line-height: 1.1;
      }
      .cta-band p { margin: 0 0 1.8rem; font-size: 1.1rem; opacity: 0.95; }
      .cta-band .phone-big {
        display: inline-block; font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800;
        color: #fff; text-decoration: none; letter-spacing: 0.02em;
        background: rgba(0,0,0,0.18); padding: 0.7rem 2rem; border-radius: 999px;
        border: 2px solid rgba(255,255,255,0.5);
        transition: transform 0.15s ease, background 0.15s ease;
      }
      .cta-band .phone-big:hover { transform: scale(1.04); background: rgba(0,0,0,0.28); }


      /* ---------- FAQ ---------- */
      .faq { max-width: 800px; margin: 0 auto; }
      .faq details {
        background: var(--card); border: 1px solid rgba(36,26,18,0.08);
        border-radius: 14px; margin-bottom: 0.8rem; overflow: hidden;
        box-shadow: 0 8px 20px -12px rgba(36, 26, 18, 0.2);
      }
      .faq summary {
        cursor: pointer; padding: 1.15rem 1.4rem; font-weight: 700;
        font-size: 1.05rem; list-style: none; display: flex;
        justify-content: space-between; align-items: center; gap: 1rem;
      }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after {
        content: "+"; font-size: 1.5rem; font-weight: 400; color: var(--gold-deep);
        flex-shrink: 0; transition: transform 0.15s ease;
      }
      .faq details[open] summary::after { transform: rotate(45deg); }
      .faq summary:hover { color: var(--gold-deep); }
      .faq .answer { padding: 0 1.4rem 1.3rem; color: var(--muted); }
      .faq .answer p { margin: 0 0 0.6rem; }
      .faq .answer p:last-child { margin-bottom: 0; }
      .faq .answer a { color: var(--gold-deep); font-weight: 700; }

      /* ---------- Footer ---------- */
      footer { padding: 2.5rem 0 3rem; color: var(--muted); font-size: 0.92rem; }
      .foot-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
      .foot-brand { font-weight: 800; color: var(--espresso); font-size: 1.05rem; }
      .foot-brand span { color: var(--gold-deep); }

      /* ---------- Responsive ---------- */
      @media (max-width: 860px) {
        .grid { grid-template-columns: 1fr; }
        .work-grid { grid-template-columns: repeat(2, 1fr); }
        .visit-cards { grid-template-columns: 1fr; }
        .nav-links a.link { display: none; }
        .hero { padding: 3.5rem 0 3rem; }
        .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
        .hero-photo { justify-self: center; }
        .hero-photo img { height: 440px; }
        .hero-badge { left: 8px; }
        section.block { padding: 3rem 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="#top" aria-label="Joy Braiding home">
          <img class="brand-logo" src="/logo.png" alt="Joy Braiding logo" />
          <span class="brand-name">Joy <span>Braiding</span></span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a class="link" href="#services">Services</a>
          <a class="link" href="#work">Work</a>
          <a class="link" href="#visit">Visit</a>
          <a class="link" href="#contact">Contact</a>
          <a class="btn btn-gold" href={PHONE_LINK}>📞 {PHONE_DISPLAY}</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <span class="pill"><span class="dot"></span> Duluth, Georgia</span>
            <h1>Hair braiding in Duluth, <em>done right.</em></h1>
            <p class="lead">
              Joy Braiding specializes in flawless, long-lasting protective styles —
              from classic box braids to lightweight knotless looks. Neat parts,
              gentle hands, and styles that turn heads.
            </p>
            <div class="hero-ctas">
              <a class="btn btn-dark" href={PHONE_LINK}>Call or Text to Book</a>
              <a class="btn btn-outline" href="#services">See services &amp; prices</a>
            </div>
            <div class="hero-meta">
              <div><strong>4 signature styles</strong>Transparent pricing</div>
              <div><strong>By appointment</strong>Call or text to reserve</div>
              <div><strong>Duluth, GA</strong>Serving the local community</div>
            </div>
          </div>
          <div class="hero-photo">
            <img src="/joe.jpg" alt="Joy — professional hair braider in Duluth, GA" />
            <div class="hero-badge">✨ Professional braider</div>
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section class="block services" id="services">
        <div class="wrap">
          <p class="kicker">Services &amp; pricing</p>
          <h2 class="title">Pick your style</h2>
          <p class="sub">
            Every style is braided with care for a neat, comfortable finish.
            Final pricing confirmed when you book — call or text to reserve your spot.
          </p>
          <div class="grid">
            {services.map((s) => (
              <article class="card">
                <span class="tag">{s.tag}</span>
                <div class="card-top">
                  <h3>{s.name}</h3>
                  <span class="price">${s.price}</span>
                </div>
                <p>{s.desc}</p>
                <a class="book" href={PHONE_LINK}>Book this style</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- WORK -->
      <section class="block" id="work">
        <div class="wrap">
          <p class="kicker">Real work</p>
          <h2 class="title">Styles by Joy</h2>
          <p class="sub">
            Recent looks from real appointments — neat parts, gentle hands, and
            styles made to last. Yours could be next.
          </p>
          <div class="work-grid">
            <figure class="work-item">
              <img src="/gallery/boho-knotless.jpg" alt="Boho knotless braids with curly ends by Joy Braiding in Duluth, GA" loading="lazy" />
              <figcaption>Boho knotless braids</figcaption>
            </figure>
            <figure class="work-item">
              <img src="/gallery/cornrows-twists.jpg" alt="Feed-in cornrows styled into twists by Joy Braiding in Duluth, GA" loading="lazy" />
